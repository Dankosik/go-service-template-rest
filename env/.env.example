# New namespace (canonical): APP__<DOMAIN>__<FIELD>.
# Policy reference (what goes to YAML vs ENV): docs/configuration-source-policy.md
APP__APP__ENV=local
APP__APP__VERSION=dev
APP__HTTP__ADDR=:8080
APP__HTTP__SHUTDOWN_TIMEOUT=30s
APP__HTTP__READINESS_TIMEOUT=4s
APP__HTTP__READINESS_PROPAGATION_DELAY=0s
APP__HTTP__READ_HEADER_TIMEOUT=5s
APP__HTTP__READ_TIMEOUT=5s
APP__HTTP__WRITE_TIMEOUT=10s
APP__HTTP__IDLE_TIMEOUT=60s
APP__HTTP__MAX_HEADER_BYTES=16384
APP__HTTP__MAX_BODY_BYTES=1048576
# Platform probes are excluded from the access log by default. Set true only
# while debugging readiness; orchestrators poll these routes continuously.
APP__HTTP__ACCESS_LOG_HEALTH_PROBES=false
APP__LOG__LEVEL=info
APP__OBSERVABILITY__METRICS__ADDR=127.0.0.1:9090
APP__OBSERVABILITY__OTEL__SERVICE_NAME=service
APP__OBSERVABILITY__OTEL__TRACES_SAMPLER=parentbased_traceidratio
APP__OBSERVABILITY__OTEL__TRACES_SAMPLER_ARG=0.10
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_ENDPOINT=
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_HEADERS=

# profile:database-postgres:start
# Postgres (DATABASE=postgres profile).
# Local-only Compose credentials; deployments must supply their own secret DSN.
APP__POSTGRES__ENABLED=true
APP__POSTGRES__DSN=postgres://app:app@127.0.0.1:5432/app?sslmode=disable
APP__POSTGRES__MIGRATION_TIMEOUT=5m
APP__POSTGRES__MIGRATION_STATEMENT_TIMEOUT=2m
APP__POSTGRES__MIGRATION_LOCK_TIMEOUT=15s
# profile:database-postgres:end

# Optional OTLP/HTTP trace exporter. The endpoint is a full http(s) URL;
# a missing path defaults to /v1/traces.
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_ENDPOINT=http://localhost:4318
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_HEADERS=
