# New namespace (canonical): APP__<DOMAIN>__<FIELD>.
# Policy reference (what goes to YAML vs ENV): docs/configuration-source-policy.md
APP__APP__ENV=local
APP__APP__VERSION=dev
# Source revision this build came from. The image build stamps it through
# --build-arg VCS_REF; set it only on a platform that knows the revision without
# driving the build. It is published as the vcs.revision resource attribute and
# served by the diagnostics listener at GET /debug/buildinfo.
APP__APP__COMMIT=unknown
# Identifies this replica in exported telemetry. Empty resolves to the hostname,
# which is the pod name on Kubernetes and the container id on most platforms.
# Set it only on a platform that exposes neither.
APP__APP__INSTANCE_ID=
APP__HTTP__ADDR=:8080
# Total time the platform allows between SIGTERM and SIGKILL:
# terminationGracePeriodSeconds on Kubernetes (30s by default),
# drainingSeconds on Railway. Every teardown stage draws from it, and startup
# rejects a SHUTDOWN_TIMEOUT that cannot fit inside it alongside the ~17s the
# post-drain stages need.
APP__HTTP__GRACE_PERIOD=45s
# Bounds the HTTP drain only, including READINESS_PROPAGATION_DELAY. Closing
# diagnostics, joining background work, releasing the pool, and flushing
# telemetry all still run after it, inside GRACE_PERIOD.
APP__HTTP__SHUTDOWN_TIMEOUT=25s
APP__HTTP__READINESS_TIMEOUT=4s
APP__HTTP__READINESS_PROPAGATION_DELAY=0s
APP__HTTP__READ_HEADER_TIMEOUT=5s
APP__HTTP__READ_TIMEOUT=5s
# Per-request handler budget. Cancels the request context so outbound calls and
# queries unwind; must stay <= APP__HTTP__WRITE_TIMEOUT so the 504 can be sent.
APP__HTTP__REQUEST_TIMEOUT=8s
APP__HTTP__WRITE_TIMEOUT=10s
APP__HTTP__IDLE_TIMEOUT=60s
APP__HTTP__MAX_HEADER_BYTES=16384
APP__HTTP__MAX_BODY_BYTES=1048576
# Concurrent handler ceiling. Excess arrivals are shed with 503 + Retry-After
# instead of queueing on a finite resource until every request burns its budget.
# Must be >= APP__POSTGRES__MAX_OPEN_CONNS. 0 disables shedding.
APP__HTTP__MAX_IN_FLIGHT=256
# Accepted-connection ceiling. MAX_IN_FLIGHT bounds handler execution; every
# connection beyond it still costs a goroutine and its buffers before any
# middleware runs. Excess callers wait in the kernel backlog. Must be >=
# APP__HTTP__MAX_IN_FLIGHT. 0 accepts without a bound.
APP__HTTP__MAX_CONNECTIONS=4096
# Platform probes are excluded from the access log by default. Set true only
# while debugging readiness; orchestrators poll these routes continuously.
APP__HTTP__ACCESS_LOG_HEALTH_PROBES=false

# profile:authn-oidc-jwt:start
# Required OIDC JWT trust boundary. Replace every example value with the real
# issuer, resource-server audience, and the CIDRs of TLS-terminating proxies
# before starting the service; the process fails closed without initial trust.
APP__AUTHN__ISSUER=https://issuer.example.com
APP__AUTHN__AUDIENCE=https://api.example.com
# profile:jobs-postgres:start
# The source template is inert. A selected jobs worker starts with one worker;
# raise this only from database and downstream-capacity evidence.
APP__JOBS__MAX_WORKERS=1
# profile:jobs-postgres:end
APP__AUTHN__TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
# profile:authn-oidc-jwt:end

# profile:http-idempotency-postgres:start
# The published client retry window has no template default. Supply it only
# after an operation declares x-idempotent: true.
APP__HTTP_IDEMPOTENCY__RETENTION=0s
# profile:http-idempotency-postgres:end

# profile:outbound-auth-oauth2-client-credentials:start
# One fixed OAuth client-credentials dependency. The client secret has no
# file-backed value and must remain blank in every example.
APP__OUTBOUND_AUTH__DEPENDENCY=
APP__OUTBOUND_AUTH__CLIENT_ID=
APP__OUTBOUND_AUTH__CLIENT_SECRET=
APP__OUTBOUND_AUTH__CLIENT_AUTHENTICATION=client_secret_basic
APP__OUTBOUND_AUTH__TOKEN_ENDPOINT=
APP__OUTBOUND_AUTH__TOKEN_TARGET_CLASS=external_https
APP__OUTBOUND_AUTH__TOKEN_PRIVATE_HOST_SUFFIX=
APP__OUTBOUND_AUTH__SCOPES=
APP__OUTBOUND_AUTH__RESOURCE=
APP__OUTBOUND_AUTH__AUDIENCE=
APP__OUTBOUND_AUTH__RESOURCE_AUTHORITY=
APP__OUTBOUND_AUTH__ACQUISITION_TIMEOUT=0s
# profile:outbound-auth-oauth2-client-credentials:end

# profile:grpc:start
# Optional native gRPC listener (GRPC=enabled template profile). Enabling it
# requires an address and an explicit transport policy. Production deployments
# should use tls with a mounted certificate/key pair. Plaintext additionally
# requires ALLOW_PLAINTEXT=true and is intended only for a trusted private
# network or local development.
APP__GRPC__SERVER__ENABLED=false
APP__GRPC__SERVER__ADDR=
APP__GRPC__SERVER__TRANSPORT_SECURITY=
APP__GRPC__SERVER__ALLOW_PLAINTEXT=false
APP__GRPC__SERVER__TLS__CERT_FILE=
APP__GRPC__SERVER__TLS__KEY_FILE=
# Naming a trust root turns the listener into a mutual-TLS boundary: every
# caller must then present a certificate chaining to it.
APP__GRPC__SERVER__TLS__CLIENT_CA_FILE=
# Process-wide RPC handler ceiling, per-connection HTTP/2 stream ceiling, and
# accepted-connection ceiling. Unary and all streaming cardinalities share the
# process admission limit.
APP__GRPC__SERVER__MAX_CONNECTIONS=4096
APP__GRPC__SERVER__MAX_CONCURRENT_RPCS=256
APP__GRPC__SERVER__MAX_CONCURRENT_STREAMS=100
APP__GRPC__SERVER__MAX_HEADER_LIST_BYTES=16384
APP__GRPC__SERVER__MAX_RECEIVE_MESSAGE_BYTES=4194304
APP__GRPC__SERVER__MAX_SEND_MESSAGE_BYTES=4194304
# Standard gRPC health polling is omitted from access logs by default.
APP__GRPC__SERVER__ACCESS_LOG_HEALTH_CHECKS=false
# Successful business RPCs are fully logged by default. For a measured
# high-throughput workload, lower this rate in [0,1]; errors always remain
# visible. A positive slow threshold retains successful calls at or above that
# duration regardless of sampling. 0s disables the slow override because the
# template has no service-specific latency SLO.
APP__GRPC__SERVER__ACCESS_LOG_SUCCESS_SAMPLE_RATE=1
APP__GRPC__SERVER__ACCESS_LOG_SLOW_THRESHOLD=0s
# Routine health polling is excluded from server-side OTel spans and duration
# metrics. Enable only for focused health diagnostics.
APP__GRPC__SERVER__TELEMETRY_HEALTH_CHECKS=false
# How long one RPC may occupy a handler. The bound derives the RPC context's
# deadline, so a caller deadline that is already earlier still wins. The unary
# value matches HTTP__REQUEST_TIMEOUT so one service answers on one budget over
# both transports; 0s disables the cap. Streams are unbounded by default because
# a long-lived stream's duration policy belongs to the feature that owns it.
APP__GRPC__SERVER__UNARY_TIMEOUT=8s
APP__GRPC__SERVER__STREAM_TIMEOUT=0s
# Connection liveness. None of these can end an RPC in progress: the idle clock
# only runs while nothing is outstanding, and the ping bound closes only when a
# ping goes unanswered. Without them a vanished peer holds a listener slot for
# gRPC's two-hour default. The client-ping minimum bounds what a caller may do
# and must stay below the ping interval its client uses.
APP__GRPC__SERVER__MAX_CONNECTION_IDLE=15m
APP__GRPC__SERVER__SERVER_PING_INTERVAL=1m
APP__GRPC__SERVER__SERVER_PING_TIMEOUT=20s
APP__GRPC__SERVER__MIN_CLIENT_PING_INTERVAL=10s
APP__GRPC__SERVER__PERMIT_PING_WITHOUT_STREAM=true
# Connection rotation, off by default because it is the only bound here that ends
# work in progress: at this age the connection is drained and then force-closed
# once the grace expires, cutting every RPC and stream still running. Enable it
# behind an L4 balancer or any hop that pins a caller to one replica for a
# connection's lifetime, and expect long-lived streams to end with UNAVAILABLE.
# The grace must be positive and at least UNARY_TIMEOUT whenever an age is set.
APP__GRPC__SERVER__MAX_CONNECTION_AGE=0s
APP__GRPC__SERVER__MAX_CONNECTION_AGE_GRACE=10s
# profile:grpc:end

# Readiness is evaluated on this interval by a background refresher, not per
# request, so a probe route never consumes the capacity it reports on. Readiness
# flips only after FAILURE_THRESHOLD consecutive failures.
APP__HEALTH__REFRESH_INTERVAL=2s
APP__HEALTH__FAILURE_THRESHOLD=3
APP__LOG__LEVEL=info

# profile:messaging-nats-jetstream:start
# Optional direct NATS JetStream pack. Streams are operator-owned and must
# already exist. The service process is producer-only; cmd/worker owns the
# durable pull consumer. Local plaintext/unauthenticated use requires both
# explicit escape hatches shown here.
APP__MESSAGING__ENABLED=false
APP__MESSAGING__URLS=nats://127.0.0.1:4222
APP__MESSAGING__CREDENTIALS_FILE=
APP__MESSAGING__ROOT_CA_FILE=
APP__MESSAGING__ALLOW_PLAINTEXT=true
APP__MESSAGING__ALLOW_UNAUTHENTICATED=true
APP__MESSAGING__STREAM=EVENTS
APP__MESSAGING__MAX_PAYLOAD_BYTES=262144
APP__MESSAGING__MAX_PENDING_PUBLISHES=64
APP__MESSAGING__WORKER__CONSUMER=events-worker
APP__MESSAGING__WORKER__FILTER_SUBJECT=events.>
APP__MESSAGING__WORKER__DEAD_LETTER_SUBJECT=dead.events
APP__MESSAGING__WORKER__MAX_CONCURRENCY=8
APP__MESSAGING__WORKER__MAX_DELIVERY_BYTES=1048576
APP__MESSAGING__WORKER__HANDLER_TIMEOUT=30s
APP__MESSAGING__WORKER__RETRY_DELAYS=1s,5s,30s,2m
APP__MESSAGING__WORKER__DEAD_LETTER_RETRY_DELAY=30s
APP__MESSAGING__WORKER__DRAIN_TIMEOUT=20s
# profile:messaging-nats-jetstream:end

# Fraction of the detected cgroup memory limit handed to the GC via
# debug.SetMemoryLimit. 0 disables detection. GOMAXPROCS is deliberately not
# configurable: Go derives it from the cgroup CPU limit on its own.
APP__RUNTIME__MEMORY_LIMIT_RATIO=0.9

# profile:object-storage:start
# S3-compatible object storage has no executable defaults. Supply one complete
# immutable tuple through the environment; leave every example value blank or zero.
APP__OBJECT_STORAGE__PROVIDER=
APP__OBJECT_STORAGE__ENDPOINT=
APP__OBJECT_STORAGE__REGION=
APP__OBJECT_STORAGE__BUCKET=
APP__OBJECT_STORAGE__ACCESS_KEY_ID=
APP__OBJECT_STORAGE__SECRET_ACCESS_KEY=
APP__OBJECT_STORAGE__SESSION_TOKEN=
APP__OBJECT_STORAGE__EXPECTED_BUCKET_OWNER=
APP__OBJECT_STORAGE__MAX_OBJECT_BYTES=0
APP__OBJECT_STORAGE__MULTIPART_CHUNK_BYTES=0
APP__OBJECT_STORAGE__MAX_ACTIVE_OPERATIONS=0
APP__OBJECT_STORAGE__MAX_OPERATION_DURATION=0s
APP__OBJECT_STORAGE__MAX_PRESIGN_LIFETIME=0s
APP__OBJECT_STORAGE__MAX_RESPONSE_HEADER_BYTES=0
APP__OBJECT_STORAGE__MAX_CONTROL_RESPONSE_BYTES=0
APP__OBJECT_STORAGE__MAX_WORKING_MEMORY_BYTES=0
# profile:object-storage:end

# Diagnostics listener. Binds every interface so a metrics scraper in another
# pod can reach it; the container image does not publish this port.
APP__OBSERVABILITY__METRICS__ADDR=:9090
# net/http/pprof on the diagnostics listener. Off by default: the handlers
# disclose heap contents and process arguments.
APP__OBSERVABILITY__PPROF__ENABLED=false
APP__OBSERVABILITY__OTEL__SERVICE_NAME=service
APP__OBSERVABILITY__OTEL__TRACES_SAMPLER=parentbased_traceidratio
APP__OBSERVABILITY__OTEL__TRACES_SAMPLER_ARG=0.10
# OTLP collector. A bare root (https://collector:4318) serves both signals and
# resolves to /v1/traces and /v1/metrics. A value that already carries a path
# names the traces endpoint only; metrics then need OTLP_METRICS_ENDPOINT.
# Empty falls back to the standard OTEL_EXPORTER_OTLP_* variables a platform
# injects, for both signals.
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_ENDPOINT=
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_METRICS_ENDPOINT=
# Collector credential. Covers both signals, and pins the destination: with a
# credential set, an endpoint this service did not name is not used.
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_HEADERS=

# profile:database-postgres:start
# Postgres (DATABASE=postgres profile).
# Local-only Compose credentials; deployments must supply their own secret DSN.
APP__POSTGRES__ENABLED=true
APP__POSTGRES__DSN=postgres://app:app@127.0.0.1:5432/app?sslmode=disable
# Optional deployment connection ceiling. Keep 4 unless database capacity and
# replica count prove another value safe.
APP__POSTGRES__MAX_OPEN_CONNS=4
# profile:database-postgres:end

# profile:webhooks-durable:start
# Durable outbound webhooks (WEBHOOKS=durable) remain disabled until deployment
# supplies every bound and one revisioned owner/destination/key manifest.
APP__WEBHOOKS__ENABLED=false
APP__WEBHOOKS__CAPACITY_REVISION=0
APP__WEBHOOKS__GLOBAL_CONCURRENCY=0
APP__WEBHOOKS__CLAIM_SCAN_PAGE=0
APP__WEBHOOKS__POLL_INTERVAL=0s
APP__WEBHOOKS__OBSERVATION_INTERVAL=0s
APP__WEBHOOKS__STORE_OPERATION_TIMEOUT=0s
APP__WEBHOOKS__ATTEMPT_TIMEOUT=0s
APP__WEBHOOKS__RESPONSE_HEADER_TIMEOUT=0s
APP__WEBHOOKS__RESPONSE_HEADER_BYTES=0
APP__WEBHOOKS__RESPONSE_BODY_BYTES=0
APP__WEBHOOKS__DRAIN_TIMEOUT=0s
APP__WEBHOOKS__MAINTENANCE_INTERVAL=0s
APP__WEBHOOKS__MAINTENANCE_BATCH=0
# Environment-only JSON shape:
# {"revision":1,"entries":[{"owner_scope":"owner-a","destination_id":"dest-01","reference":"key-01","secret":"whsec_<base64url>"}]}
APP__WEBHOOKS__STATIC_SECRETS=
# profile:webhooks-durable:end

# profile:outbox-postgres:start
# PostgreSQL transactional outbox (OUTBOX=postgres). Publication is explicitly
# at-least-once: a relay crash after broker acknowledgement can publish the same
# event ID again, so consumers must tolerate duplicates.
APP__OUTBOX__ENABLED=true
APP__OUTBOX__POLL_INTERVAL=500ms
APP__OUTBOX__BATCH_SIZE=500
APP__OUTBOX__PUBLISH_CONCURRENCY=16
APP__OUTBOX__PUBLISH_TIMEOUT=10s
APP__OUTBOX__LEASE_DURATION=30s
APP__OUTBOX__MAX_ATTEMPTS=10
APP__OUTBOX__RETRY_BASE=1s
APP__OUTBOX__RETRY_MAX=5m
APP__OUTBOX__OBSERVATION_INTERVAL=5s
APP__OUTBOX__CLEANUP_INTERVAL=1m
APP__OUTBOX__PUBLISHED_RETENTION=168h
APP__OUTBOX__CLEANUP_BATCH_SIZE=1000
APP__OUTBOX__DRAIN_TIMEOUT=20s
# profile:outbox-postgres:end

# Optional OTLP/HTTP trace exporter. The endpoint is a full http(s) URL;
# a missing path defaults to /v1/traces.
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_ENDPOINT=http://localhost:4318
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_HEADERS=
