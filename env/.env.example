# New namespace (canonical): APP__<DOMAIN>__<FIELD>.
# Policy reference (what goes to YAML vs ENV): docs/configuration-source-policy.md
APP__APP__ENV=local
APP__APP__VERSION=dev
APP__HTTP__ADDR=:8080
APP__HTTP__SHUTDOWN_TIMEOUT=30s
APP__HTTP__READINESS_TIMEOUT=4s
APP__HTTP__READINESS_PROPAGATION_DELAY=15s
APP__HTTP__READ_HEADER_TIMEOUT=5s
APP__HTTP__READ_TIMEOUT=5s
APP__HTTP__WRITE_TIMEOUT=10s
APP__HTTP__IDLE_TIMEOUT=60s
APP__HTTP__MAX_HEADER_BYTES=16384
APP__HTTP__MAX_BODY_BYTES=1048576
APP__LOG__LEVEL=info
APP__OBSERVABILITY__OTEL__SERVICE_NAME=billing-service
APP__OBSERVABILITY__OTEL__TRACES_SAMPLER=parentbased_traceidratio
APP__OBSERVABILITY__OTEL__TRACES_SAMPLER_ARG=0.10
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_ENDPOINT=
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_TRACES_ENDPOINT=
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_HEADERS=
APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_PROTOCOL=http/protobuf

# Postgres (if enabled).
APP__POSTGRES__ENABLED=false
APP__POSTGRES__DSN=

# Redis/Mongo are additive domains in v1 and disabled by default.
APP__REDIS__ENABLED=false
APP__REDIS__MODE=cache
APP__REDIS__ALLOW_STORE_MODE=false
APP__MONGO__ENABLED=false
APP__MONGO__URI=
APP__MONGO__DATABASE=app

# Microlease runtime is default-closed. Enabling it also requires Postgres,
# service auth, and Redpanda, while Redis remains disabled for the first target.
APP__MICROLEASE__ENABLED=false
APP__MICROLEASE__WORKER_ENABLED=false
APP__MICROLEASE__DEFAULT_ADMISSION_STATE=fail_closed
APP__MICROLEASE__MAX_MICROLEASE_USD_ATOMS=100000000
APP__MICROLEASE__ACCOUNT_MICROLEASE_EXPOSURE_CAP_USD_ATOMS=200000000
APP__MICROLEASE__MIN_SAFETY_FLOOR_USD_ATOMS=5000000
APP__MICROLEASE__TTL=30s
APP__MICROLEASE__DEBIT_CUTOFF_BEFORE_EXPIRY=5s
APP__MICROLEASE__TERMINAL_DEADLINE=120s
APP__MICROLEASE__STALE_DEBIT_WARNING_AGE=60s
APP__MICROLEASE__STALE_DEBIT_CRITICAL_AGE=180s
APP__MICROLEASE__RECONCILIATION_SLA=5m
APP__MICROLEASE__ADMISSION_CONTROL_RENEWAL_INTERVAL=30s
APP__MICROLEASE__ADMISSION_CONTROL_MAX_STALENESS=45s
APP__MICROLEASE__REFILL_THRESHOLD_PERCENT=25
APP__MICROLEASE__MAX_ISSUE_TRANSACTION_DURATION=100ms
APP__MICROLEASE__MAX_TERMINAL_TRANSACTION_DURATION=250ms
APP__MICROLEASE__MAX_RECONCILIATION_SCAN_BATCH_SIZE=100
APP__MICROLEASE__FIRST_ROLLOUT_RISK_ACCEPTANCE_RECORDED=false
APP__SERVICE_AUTH__ENABLED=false
APP__SERVICE_AUTH__ISSUER=
APP__SERVICE_AUTH__AUDIENCE=
APP__SERVICE_AUTH__JWKS_URL=
APP__REDPANDA__ENABLED=false
APP__REDPANDA__BROKERS=
APP__REDPANDA__TERMINAL_TOPIC=billing.microlease.terminal.v1
APP__REDPANDA__CHECKPOINT_TOPIC=billing.microlease.checkpoint.v1
APP__REDPANDA__CLOSE_TOPIC=billing.microlease.close.v1
APP__REDPANDA__BILLING_FACTS_TOPIC=billing.microlease.facts.v1
APP__REDPANDA__CONSUMER_GROUP=billing-service-microleases
APP__REDPANDA__HEALTHCHECK_TIMEOUT=3s

# Balance and usage authority cutover runtime is default-disabled. Enabling it
# requires Postgres, scoped service auth, microlease runtime, billing worker,
# Redpanda, fresh admission controls, and Redis not acting as spend authority.
APP__BALANCE_USAGE_AUTHORITY__ENABLED=false
APP__BALANCE_USAGE_AUTHORITY__MODE=inert_expand
APP__BALANCE_USAGE_AUTHORITY__REQUIRE_WORKER_READY=true
APP__BALANCE_USAGE_AUTHORITY__REQUIRE_REDPANDA_READY=true
APP__BALANCE_USAGE_AUTHORITY__REQUIRE_ADMISSION_CONTROL_FRESH=true
APP__BALANCE_USAGE_AUTHORITY__MAX_ADMISSION_CONTROL_STALENESS=45s
APP__BALANCE_USAGE_AUTHORITY__REJECT_REDIS_SPEND_AUTHORITY=true
APP__BALANCE_USAGE_AUTHORITY__FAIL_CLOSED_WHEN_DEPENDENCY_NOT_READY=true

# Bootstrap-owned network policy controls. Keep examples commented so local
# copies do not silently declare production ingress or exception policy.
# NETWORK_PUBLIC_INGRESS_ENABLED=false
# NETWORK_EGRESS_ALLOWLIST=api.example.com,*.internal.example.com
# NETWORK_EGRESS_ALLOWED_SCHEMES=tcp,https
# NETWORK_INGRESS_EXCEPTION_ACTIVE=false
# NETWORK_INGRESS_EXCEPTION_ID=
# NETWORK_INGRESS_EXCEPTION_OWNER=
# NETWORK_INGRESS_EXCEPTION_REASON=
# NETWORK_INGRESS_EXCEPTION_SCOPE=
# NETWORK_INGRESS_EXCEPTION_EXPIRY=
# NETWORK_INGRESS_EXCEPTION_ROLLBACK_PLAN=
# NETWORK_EGRESS_EXCEPTION_ACTIVE=false
# NETWORK_EGRESS_EXCEPTION_ID=
# NETWORK_EGRESS_EXCEPTION_OWNER=
# NETWORK_EGRESS_EXCEPTION_REASON=
# NETWORK_EGRESS_EXCEPTION_SCOPE=
# NETWORK_EGRESS_EXCEPTION_EXPIRY=
# NETWORK_EGRESS_EXCEPTION_ROLLBACK_PLAN=

# Optional OTLP exporter settings for trace export.
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_ENDPOINT=http://localhost:4318
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_TRACES_ENDPOINT=
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_HEADERS=
# APP__OBSERVABILITY__OTEL__EXPORTER__OTLP_PROTOCOL=http/protobuf
