# Copy to .env.bench and replace every workload value before using the result
# as evidence. These numbers are wiring defaults, not template SLOs.
HTTP_BENCH_WORKLOAD_ID=replace-with-named-fixture
HTTP_BENCH_BASE_URL=http://host.docker.internal:8080
HTTP_BENCH_PATH=/api/replace-with-business-flow
HTTP_BENCH_METHOD=GET
HTTP_BENCH_RATE=10
HTTP_BENCH_DURATION=30s
HTTP_BENCH_PRE_ALLOCATED_VUS=10
HTTP_BENCH_TIMEOUT=5s
HTTP_BENCH_LATENCY_PERCENTILE=95
HTTP_BENCH_LATENCY_MS=500
HTTP_BENCH_MAX_ERROR_RATE=0.01
HTTP_BENCH_EXPECTED_STATUS=200
HTTP_BENCH_HEADERS_JSON={"Accept":"application/json"}
