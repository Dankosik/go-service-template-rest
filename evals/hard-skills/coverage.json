{
  "schema_version": 2,
  "required_categories": [
    "trigger",
    "non_trigger",
    "collision",
    "decision",
    "completion"
  ],
  "selector_category": "reference_selection",
  "mutation_category": "mutation",
  "required_mutations": [
    "blocked_sender",
    "green_schema_compatibility",
    "middleware_status_only",
    "parallel_handler_fallback",
    "raw_path_metric_label",
    "retry_budget_overrun",
    "sleep_flake_mask",
    "unmeasured_cache",
    "wrapped_dependency_sentinel"
  ],
  "required_ablations": [
    "routing",
    "method",
    "reference"
  ],
  "minimum_repeats": 3,
  "behavior_metrics": [
    "route_precision",
    "route_recall",
    "abstain_accuracy",
    "neighbor_collision_rate",
    "method_delta_over_ablation",
    "completion_false_positive_rate",
    "reference_load_precision",
    "behavior_pass_rate"
