new file mode 100644
--- /dev/null
+++ b/internal/instructioneval/flaky/flaky_test.go
@@ -0,0 +1,19 @@
+package flaky
+
+import (
+	"testing"
+	"time"
+)
+
+func TestReady(t *testing.T) {
+	ready := make(chan struct{})
+	go func() {
+		close(ready)
+	}()
+
+	select {
+	case <-ready:
+	case <-time.After(time.Nanosecond):
+		t.Fatal("worker did not become ready")
+	}
+}
