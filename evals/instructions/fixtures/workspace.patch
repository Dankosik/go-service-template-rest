+++ b/internal/instructioneval/reviewdrill/rewrite.go
@@ -0,0 +1,13 @@
+package reviewdrill
+
+func RewriteLegacyMethod(method string) string {
+	normalized := legacyName(method)
+	if normalized == "PATCH" {
+		return "POST"
+	}
+	return normalized
+}
+
+func legacyName(method string) string {
+	return method
+}
