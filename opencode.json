{
  "$schema": "https://opencode.ai/config.json",
  "model": "xai/grok-4.6",
  "subagent_depth": 2,
  "instructions": [".opencode/rules/harness.md"],
  "lsp": true,
  "formatter": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "lsp": "allow",
    "skill": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  },
  "experimental": {
    "mcp_timeout": 15000
  }
}
