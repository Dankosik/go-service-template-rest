package bootstrap

import (
	"context"

	"github.com/example/go-service-template-rest/internal/background"
	"github.com/example/go-service-template-rest/internal/config"
	"github.com/example/go-service-template-rest/internal/health"
	httpx "github.com/example/go-service-template-rest/internal/infra/http"
	"github.com/example/go-service-template-rest/internal/problem"
)

// runtimeDependencies is the DATABASE=none profile's dependency set. Readiness
// has nothing to probe beyond startup admission and the process itself.
//
// This profile carries no PostgreSQL configuration at all, so an
// APP__POSTGRES__* variable is rejected by config validation as an unknown key
// rather than by a runtime check here.
type runtimeDependencies struct {
	health *health.Service
}

// IdempotencyStore mirrors the PostgreSQL profile's accessor. This profile has no
// storage that satisfies the two properties the middleware needs — a single atomic
// claim and expiry — so it returns nil and the middleware stays out of the chain.
func (runtimeDependencies) IdempotencyStore() httpx.IdempotencyStore { return nil }

// BackgroundTasks mirrors the PostgreSQL profile's accessor so the shared startup
// path in run.go compiles against either profile. This profile's dependencies need
// no supervised work.
func (runtimeDependencies) BackgroundTasks() []background.Task { return nil }

// DomainErrors mirrors the PostgreSQL profile's accessor. This profile holds no
// dependency whose failures the transport has to classify, so a handler's own
// errors are the only ones a service maps here.
func (runtimeDependencies) DomainErrors() []problem.Mapper { return nil }

// Close takes a context to match the PostgreSQL profile's signature, which needs
// one to bound a pool release that can outlive the HTTP drain. This profile holds
// nothing that can block, so it ignores it.
func (runtimeDependencies) Close(_ context.Context) {}

// The error result exists because the PostgreSQL profile's implementation of
// this signature can fail; this profile has nothing that can.
//
//nolint:unparam // Profile-shared signature; the PostgreSQL profile returns errors here.
func initRuntimeDependencies(
	_ context.Context,
	_ startupBootstrap,
) (runtimeDependencies, error) {
	return runtimeDependencies{health: health.New()}, nil
}

// validateStartupBudgetCompatibility relates configured dependency budgets to
// the startup stage that runs them. This profile has no dependencies, so there
// is nothing to relate.
func validateStartupBudgetCompatibility(_ config.Config) error {
	return nil
}
