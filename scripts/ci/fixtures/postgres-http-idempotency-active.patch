diff --git a/cmd/service/internal/bootstrap/active_idempotency_fixture.go b/cmd/service/internal/bootstrap/active_idempotency_fixture.go
new file mode 100644
--- /dev/null
+++ b/cmd/service/internal/bootstrap/active_idempotency_fixture.go
@@ -0,0 +1,35 @@
+package bootstrap
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"github.com/acme/runtime-image-proof/internal/httpidempotency"
+	httpx "github.com/acme/runtime-image-proof/internal/infra/http"
+)
+
+func activeFixtureIdempotencyOperations() []httpx.IdempotencyOperation {
+	return []httpx.IdempotencyOperation{{
+		Contract: httpidempotency.Contract{
+			OperationID:         "activeFixture",
+			APIVersion:          "v1",
+			KeyMaxBytes:         64,
+			FingerprintVersions: []string{"v1"},
+			ResultCodecs:        []string{"fixture/v1"},
+			ReplayStatuses:      []int{http.StatusCreated},
+			ResultMaxBytes:      1024,
+			ReplayTTL:           time.Hour,
+			DuplicateRisk:       httpidempotency.DuplicateRiskPolicy{Duration: 2 * time.Hour},
+			InProgressWait:      time.Second,
+			RetryAfter:          time.Second,
+			ExternalEffect:      httpidempotency.ExternalEffectNone,
+		},
+		Authorize: func(context.Context, *http.Request) (httpidempotency.Scope, bool) {
+			return httpidempotency.Scope{Authority: "fixture", OperationID: "activeFixture", APIVersion: "v1", Resource: "fixture", Environment: "ci", Region: "local"}, true
+		},
+		Admit: func(context.Context, httpidempotency.Scope) httpidempotency.Decision {
+			return httpidempotency.Decision{Outcome: httpidempotency.OutcomeExecute}
+		},
+	}}
+}
