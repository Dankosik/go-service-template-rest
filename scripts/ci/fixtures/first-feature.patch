diff --git a/internal/infra/http/greeting_api.go b/internal/infra/http/greeting_api.go
new file mode 100644
index 0000000..f385ec0
--- /dev/null
+++ b/internal/infra/http/greeting_api.go
@@ -0,0 +1,31 @@
+package httpx
+
+import (
+	"context"
+
+	"github.com/acme/feature-proof/internal/greeting"
+	"github.com/acme/feature-proof/internal/openapi"
+)
+
+// greetingAPI implements the service's own generated operations.
+//
+// The generated interface is embedded and left unset on purpose: this type
+// implements only the operations it owns, and strictHandlers supplies the
+// platform probes, whose explicit methods shadow the embedded ones. That is what
+// lets a feature land without editing handlers.go or any other shared file.
+type greetingAPI struct {
+	openapi.StrictServerInterface
+	greeting greeting.Service
+}
+
+func (a greetingAPI) GetGreeting(_ context.Context, request openapi.GetGreetingRequestObject) (openapi.GetGreetingResponseObject, error) {
+	return openapi.GetGreeting200JSONResponse{
+		Message: a.greeting.Message(request.Name),
+	}, nil
+}
+
+// NewGreetingAPI is the constructor the composition root uses, so greetingAPI can
+// stay unexported.
+func NewGreetingAPI(service greeting.Service) openapi.StrictServerInterface {
+	return greetingAPI{greeting: service}
+}
diff --git a/internal/infra/http/greeting_api_test.go b/internal/infra/http/greeting_api_test.go
