diff --git a/internal/infra/http/greeting_handlers_test.go b/internal/infra/http/greeting_handlers_test.go
new file mode 100644
index 0000000..8bc082f
--- /dev/null
+++ b/internal/infra/http/greeting_handlers_test.go
@@ -0,0 +1,30 @@
+package httpx
+
+import (
+	"log/slog"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/acme/feature-proof/internal/greeting"
+	"github.com/acme/feature-proof/internal/health"
+	"github.com/acme/feature-proof/internal/infra/telemetry"
+)
+
+func TestGreetingEndpoint(t *testing.T) {
+	t.Parallel()
+
+	handler := mustNewRouter(t, slog.New(slog.DiscardHandler), Handlers{
+		Greeting: greeting.Service{},
+		Health:   health.New(),
+	}, telemetry.New(), RouterConfig{})
+
+	response := doRequest(handler, http.MethodGet, "/greetings/Go")
+
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusOK)
+	}
+	if body := strings.TrimSpace(response.Body.String()); body != `{"message":"Hello, Go!"}` {
+		t.Fatalf("body = %q", body)
+	}
+}
