+++ b/internal/infra/http/greeting_api_test.go
@@ -0,0 +1,49 @@
+package httpx
+
+import (
+	"context"
+	"log/slog"
+	"net/http"
+	"strings"
+	"testing"
+
+	"github.com/acme/feature-proof/internal/greeting"
+	"github.com/acme/feature-proof/internal/health"
+	"github.com/acme/feature-proof/internal/infra/telemetry"
+)
+
+func TestGreetingEndpoint(t *testing.T) {
+	t.Parallel()
+
+	handler := mustNewRouter(t, slog.New(slog.DiscardHandler), Handlers{
+		API:    greetingAPI{greeting: greeting.Service{}},
+		Health: health.New(),
+	}, telemetry.New(), RouterConfig{})
+
+	response := doRequest(handler, http.MethodGet, "/greetings/Go")
+
+	if response.Code != http.StatusOK {
+		t.Fatalf("status = %d, want %d", response.Code, http.StatusOK)
+	}
+	if body := strings.TrimSpace(response.Body.String()); body != `{"message":"Hello, Go!"}` {
+		t.Fatalf("body = %q", body)
+	}
+}
+
+// TestRouterRequiresAPIOnceContractGrows pins the guard that makes the seam safe:
+// a contract with operations beyond the platform probes must be given an
+// implementation, or the router refuses to build instead of panicking per request.
+func TestRouterRequiresAPIOnceContractGrows(t *testing.T) {
+	t.Parallel()
+
+	_, err := NewRouter(slog.New(slog.DiscardHandler), Handlers{
+		Health:        health.New(),
+		ReadinessGate: func(ctx context.Context) error { return nil },
+	}, telemetry.New(), RouterConfig{MaxBodyBytes: 1 << 20, RequestTimeout: testRouterRequestTimeout})
+	if err == nil {
+		t.Fatal("NewRouter() error = nil, want a missing-API rejection")
+	}
+	if !strings.Contains(err.Error(), "handlers API is required") {
+		t.Fatalf("NewRouter() error = %v, want it to name the missing API", err)
+	}
+}
