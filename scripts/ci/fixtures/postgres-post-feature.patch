diff --git a/test/postgres_article_feature_integration_test.go b/test/postgres_article_feature_integration_test.go
new file mode 100644
index 0000000..a44756c
--- /dev/null
+++ b/test/postgres_article_feature_integration_test.go
@@ -0,0 +1,170 @@
+//go:build integration
+
+package integration_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/acme/postgres-service/internal/article"
+	"github.com/acme/postgres-service/internal/health"
+	httpx "github.com/acme/postgres-service/internal/infra/http"
+	"github.com/acme/postgres-service/internal/infra/postgres"
+	"github.com/acme/postgres-service/internal/infra/postgresmigrate"
+	"github.com/acme/postgres-service/internal/infra/telemetry"
+	"github.com/jackc/pgx/v5/pgxpool"
+)
+
+func TestPostgresArticleVerticalSlice(t *testing.T) {
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Second)
+	defer cancel()
+
+	dsn := integrationPostgresDSN(t)
+	changed, err := postgresmigrate.MigrateUp(ctx, postgresmigrate.MigrationOptions{
+		DSN:              dsn,
+		SourceFS:         os.DirFS(".."),
+		SourcePath:       "migrations",
+		StatementTimeout: 2 * time.Minute,
+		LockTimeout:      15 * time.Second,
+	})
+	if err != nil {
+		t.Fatalf("apply fixture migration: %v", err)
+	}
+	if !changed {
+		t.Fatal("fixture migration reported no change")
+	}
+
+	pool, err := pgxpool.New(ctx, dsn)
+	if err != nil {
+		t.Fatalf("create fixture pool: %v", err)
+	}
+	t.Cleanup(pool.Close)
+
+	repository := postgres.NewArticleRepository(pool)
+	articles, err := article.NewService(repository)
+	if err != nil {
+		t.Fatalf("create article service: %v", err)
+	}
+	handler, err := httpx.NewRouter(
+		slog.New(slog.NewTextHandler(io.Discard, nil)),
+		httpx.Handlers{
+			API:           httpx.NewArticleAPI(articles),
+			Health:        health.New(),
+			ReadinessGate: func(context.Context) error { return nil },
+		},
+		telemetry.New(),
+		httpx.RouterConfig{
+			MaxBodyBytes:   1 << 20,
+			RequestTimeout: 5 * time.Second,
+			OTelServerName: "postgres-feature-proof",
+		},
+	)
+	if err != nil {
+		t.Fatalf("create fixture router: %v", err)
+	}
+
+	for _, tc := range []struct {
+		name string
+		body string
+	}{
+		{name: "malformed", body: `{"title":`},
+		{name: "invalid", body: `{"title":""}`},
+		{name: "unknown field", body: `{"title":"unknown","extra":true}`},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			response := postArticle(handler, tc.body)
+			if response.Code != http.StatusBadRequest {
+				t.Fatalf("status = %d, want %d; body = %s", response.Code, http.StatusBadRequest, response.Body)
+			}
+		})
+	}
+	assertArticleCount(t, ctx, pool, 0)
+
+	response := postArticle(handler, `{"title":"Adoption proof"}`)
+	if response.Code != http.StatusCreated {
+		t.Fatalf("valid status = %d, want %d; body = %s", response.Code, http.StatusCreated, response.Body)
+	}
+	var created struct {
+		ID    int64  `json:"id"`
+		Title string `json:"title"`
+	}
+	if err := json.Unmarshal(response.Body.Bytes(), &created); err != nil {
+		t.Fatalf("decode created article: %v", err)
+	}
+	if created.ID == 0 || created.Title != "Adoption proof" {
+		t.Fatalf("created article = %+v, want assigned id and title", created)
+	}
+	assertArticleCount(t, ctx, pool, 1)
+
+	rollbackTx, err := pool.Begin(ctx)
+	if err != nil {
+		t.Fatalf("begin rollback transaction: %v", err)
+	}
+	if _, err := postgres.NewArticleRepository(rollbackTx).Create(ctx, "Rolled back"); err != nil {
+		_ = rollbackTx.Rollback(ctx)
+		t.Fatalf("create rollback article: %v", err)
+	}
+	if err := rollbackTx.Rollback(ctx); err != nil {
+		t.Fatalf("rollback article transaction: %v", err)
+	}
+	assertArticleTitleCount(t, ctx, pool, "Rolled back", 0)
+
+	commitTx, err := pool.Begin(ctx)
+	if err != nil {
+		t.Fatalf("begin commit transaction: %v", err)
+	}
+	if _, err := postgres.NewArticleRepository(commitTx).Create(ctx, "Committed"); err != nil {
+		_ = commitTx.Rollback(ctx)
+		t.Fatalf("create committed article: %v", err)
+	}
+	if err := commitTx.Commit(ctx); err != nil {
+		t.Fatalf("commit article transaction: %v", err)
+	}
+	assertArticleTitleCount(t, ctx, pool, "Committed", 1)
+}
+
+func postArticle(handler http.Handler, body string) *httptest.ResponseRecorder {
+	request := httptest.NewRequest(http.MethodPost, "/articles", bytes.NewBufferString(body))
+	request.Header.Set("Content-Type", "application/json")
+	response := httptest.NewRecorder()
+	handler.ServeHTTP(response, request)
+	return response
+}
+
+func assertArticleCount(t *testing.T, ctx context.Context, pool *pgxpool.Pool, want int) {
+	t.Helper()
+
+	var got int
+	if err := pool.QueryRow(ctx, "SELECT count(*) FROM articles").Scan(&got); err != nil {
+		t.Fatalf("count articles: %v", err)
+	}
+	if got != want {
+		t.Fatalf("article count = %d, want %d", got, want)
+	}
+}
+
+func assertArticleTitleCount(
+	t *testing.T,
+	ctx context.Context,
+	pool *pgxpool.Pool,
+	title string,
+	want int,
+) {
+	t.Helper()
+
+	var got int
+	if err := pool.QueryRow(ctx, "SELECT count(*) FROM articles WHERE title = $1", title).Scan(&got); err != nil {
+		t.Fatalf("count article title %q: %v", title, err)
+	}
+	if got != want {
+		t.Fatalf("article title %q count = %d, want %d", title, got, want)
+	}
+}
