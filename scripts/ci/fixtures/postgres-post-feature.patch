diff --git a/internal/article/article.go b/internal/article/article.go
new file mode 100644
index 0000000..e04617b
--- /dev/null
+++ b/internal/article/article.go
@@ -0,0 +1,40 @@
+package article
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+)
+
+type Article struct {
+	ID    int64
+	Title string
+}
+
+type Repository interface {
+	Create(context.Context, string) (Article, error)
+}
+
+type Service struct {
+	repository Repository
+}
+
+func NewService(repository Repository) (*Service, error) {
+	if repository == nil {
+		return nil, errors.New("article service: repository is required")
+	}
+	return &Service{repository: repository}, nil
+}
+
+func (s *Service) Create(ctx context.Context, title string) (Article, error) {
+	title = strings.TrimSpace(title)
+	if title == "" {
+		return Article{}, errors.New("article title is required")
+	}
+	created, err := s.repository.Create(ctx, title)
+	if err != nil {
+		return Article{}, fmt.Errorf("create article: %w", err)
+	}
+	return created, nil
+}
diff --git a/internal/infra/http/article_api.go b/internal/infra/http/article_api.go
new file mode 100644
index 0000000..e8e4317
--- /dev/null
+++ b/internal/infra/http/article_api.go
@@ -0,0 +1,46 @@
+package httpx
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/acme/postgres-service/internal/article"
+	"github.com/acme/postgres-service/internal/openapi"
+)
+
+// articleAPI implements this service's own generated operations.
+//
+// The generated interface is embedded and left unset: this type implements only
+// what it owns, and strictHandlers supplies the platform probes, whose explicit
+// methods shadow the embedded ones. Adding a feature therefore adds a file
+// instead of editing handlers.go or any other shared template source.
+type articleAPI struct {
+	openapi.StrictServerInterface
+	articles *article.Service
+}
+
+// NewArticleAPI is the constructor the composition root uses.
+func NewArticleAPI(articles *article.Service) openapi.StrictServerInterface {
+	return articleAPI{articles: articles}
+}
+
+func (a articleAPI) CreateArticle(
+	ctx context.Context,
+	request openapi.CreateArticleRequestObject,
+) (openapi.CreateArticleResponseObject, error) {
+	if request.Body == nil {
+		return nil, errors.New("create article request body is required")
+	}
+	if a.articles == nil {
+		return nil, errors.New("article handler is not configured")
+	}
+	created, err := a.articles.Create(ctx, request.Body.Title)
+	if err != nil {
+		return nil, fmt.Errorf("create article: %w", err)
+	}
+	return openapi.CreateArticle201JSONResponse{
+		Id:    created.ID,
+		Title: created.Title,
+	}, nil
+}
diff --git a/internal/infra/postgres/article_repository.go b/internal/infra/postgres/article_repository.go
new file mode 100644
index 0000000..4aeff28
--- /dev/null
+++ b/internal/infra/postgres/article_repository.go
@@ -0,0 +1,28 @@
+package postgres
+
+import (
+	"context"
+	"fmt"
+
+	"github.com/acme/postgres-service/internal/article"
+	"github.com/acme/postgres-service/internal/infra/postgres/sqlcgen"
+)
+
+type ArticleRepository struct {
+	queries *sqlcgen.Queries
+}
+
+func NewArticleRepository(db sqlcgen.DBTX) *ArticleRepository {
+	return &ArticleRepository{queries: sqlcgen.New(db)}
+}
+
+func (r *ArticleRepository) Create(ctx context.Context, title string) (article.Article, error) {
+	row, err := r.queries.CreateArticle(ctx, title)
+	if err != nil {
+		return article.Article{}, fmt.Errorf("insert article: %w", err)
+	}
+	return article.Article{
+		ID:    row.ID,
+		Title: row.Title,
+	}, nil
+}
