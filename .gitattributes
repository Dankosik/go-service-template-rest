* text=auto eol=lf

# Generated artifacts: keep visible in history but collapse in review UIs where supported.
internal/openapi/openapi.gen.go linguist-generated=true
*.gen.go linguist-generated=true

# Unified-diff artifacts necessarily prefix tab-indented context with one space.
scripts/ci/fixtures/*.patch whitespace=-blank-at-eol,-space-before-tab
specs/**/*.patch whitespace=-blank-at-eol,-space-before-tab
